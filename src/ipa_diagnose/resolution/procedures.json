{
 "procedures": [
  {
   "id": "none.certs.expired-ds-certificate",
   "kind": "no_procedure",
   "reason": "The Directory Server certificate has already expired. Recovering expired IPA system certificates (ipa-cert-fix on the CA renewal master, then restarting the other servers) is a high-risk procedure that ipa-diagnose has not verified, so it shows no fix. Follow the documented procedure for your FreeIPA version.",
   "reference": "https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/html/managing_certificates_in_idm/renewing-expired-system-certificates-when-idm-is-offline_managing-certificates-in-idm",
   "resolves": {
    "diagnosis": "directory-server.certificate-expiry",
    "variant": "expired"
   }
  },
  {
   "id": "none.time.kdc-reported-skew",
   "kind": "no_procedure",
   "reason": "The KDC reported clock skew, but this host's own clock was not measured as out of sync. The clock that is wrong may be on another machine, so ipa-diagnose shows no fix here. Compare 'chronyc tracking' on both machines.",
   "resolves": {
    "diagnosis": "kerberos.clock-skew",
    "variant": "kdc-reported"
   }
  },
  {
   "applies_to": {
    "freeipa_min": "4.9",
    "roles": [
     "ipa-server"
    ]
   },
   "bindings": {
    "nickname": {
     "type": "cert_nickname"
    }
   },
   "id": "proc.certs.renew-expiring-ds-certificate",
   "investigate": [
    {
     "check": "host.privilege",
     "id": "root",
     "label": "Privileges",
     "params": {}
    },
    {
     "check": "ds.instance",
     "id": "instance",
     "label": "Directory Server instance",
     "params": {}
    },
    {
     "check": "systemd.unit",
     "id": "certmonger",
     "label": "certmonger service",
     "params": {
      "service": "certmonger"
     }
    },
    {
     "check": "certmonger.ds_cert",
     "id": "cert",
     "label": "certmonger tracking of {bind.nickname}",
     "params": {
      "instance": {
       "field": "instance",
       "ref": "instance"
      },
      "nickname": {
       "bind": "nickname"
      }
     }
    },
    {
     "check": "binary.present",
     "id": "getcert",
     "label": "getcert installed",
     "params": {
      "name": "getcert"
     }
    }
   ],
   "kind": "procedure",
   "limitations": "This renews one certificate. It does not explain why certmonger had not renewed it yet (by default it renews shortly before expiry, so an expiring warning can be normal).",
   "min_confidence": "HIGH",
   "prerequisites": [
    {
     "id": "root",
     "text": "ipa-diagnose is running as root (certmonger requests are managed by root)",
     "when": {
      "left": {
       "field": "is_root",
       "ref": "root"
      },
      "op": "is_true"
     }
    },
    {
     "id": "getcert",
     "text": "getcert is installed",
     "when": {
      "left": {
       "field": "present",
       "ref": "getcert"
      },
      "op": "is_true"
     }
    }
   ],
   "provenance": {
    "reviews": [],
    "sources": [
     {
      "kind": "upstream-docs",
      "ref": "https://pagure.io/certmonger/blob/master/f/src/getcert-resubmit.1.in",
      "title": "getcert-resubmit(1): resubmit a tracked certificate's signing request to its CA"
     },
     {
      "kind": "upstream-code",
      "ref": "https://github.com/389ds/389-ds-base/blob/main/src/lib389/lib389/lint.py",
      "title": "lib389 DSCERTLE0001: certificate about to expire - renew it before it expires"
     }
    ],
    "tests": [
     "tests/resolution/test_procedures.py"
    ],
    "tier": "FIXTURE_ONLY",
    "verified_on": []
   },
   "resolves": {
    "diagnosis": "directory-server.certificate-expiry",
    "variant": "expiring"
   },
   "rollback": [
    {
     "text": "This procedure does not keep the previous certificate. It is the same renewal certmonger performs on its own before expiry. If the new certificate is not issued, the request shows why in 'getcert list' and the current certificate stays in place until it expires."
    }
   ],
   "steps": [
    {
     "changes": [
      "certmonger-request",
      "service-restart"
     ],
     "command": [
      "getcert",
      "resubmit",
      "-i",
      {
       "field": "request_id",
       "ref": "cert",
       "type": "certmonger_request_id"
      }
     ],
     "expected": "certmonger gets a new certificate from the IPA CA and saves it; its post-save command restarts Directory Server {ref.instance.instance}. 'getcert list' shows MONITORING again with a later expiry date.",
     "id": "resubmit",
     "risk": "MEDIUM",
     "run_on": "local",
     "text": "Ask certmonger to renew {bind.nickname} now (request {ref.cert.request_id})"
    }
   ],
   "title": "Renew the expiring Directory Server certificate now",
   "verify": [
    {
     "check": "certmonger.ds_cert",
     "params": {
      "instance": {
       "field": "instance",
       "ref": "instance"
      },
      "nickname": {
       "bind": "nickname"
      }
     },
     "text": "The renewal request is back to MONITORING",
     "when": {
      "left": {
       "field": "state",
       "ref": "this"
      },
      "op": "eq",
      "right": "MONITORING"
     }
    },
    {
     "check": "certmonger.ds_cert",
     "params": {
      "instance": {
       "field": "instance",
       "ref": "instance"
      },
      "nickname": {
       "bind": "nickname"
      }
     },
     "text": "The certificate is valid for more than 30 more days",
     "when": {
      "left": {
       "field": "days_left",
       "ref": "this"
      },
      "op": "gt",
      "right": 30
     }
    }
   ],
   "what_changes": [
    {
     "text": "{bind.nickname} in /etc/dirsrv/slapd-{ref.instance.instance} is replaced by a newly issued certificate from the IPA CA. Directory Server on this server restarts once to load it (a short LDAP interruption here)."
    }
   ],
   "withhold_if": [
    {
     "reason": "Found {ref.instance.count} Directory Server instances; ipa-diagnose cannot tell which one the certificate belongs to.",
     "when": {
      "left": {
       "field": "count",
       "ref": "instance"
      },
      "op": "ne",
      "right": 1
     }
    },
    {
     "reason": "certmonger is not running ({ref.certmonger.active_state}); it performs the renewal. Start it first (ipa-diagnose reports a stopped service as its own problem).",
     "when": {
      "left": {
       "field": "active_state",
       "ref": "certmonger"
      },
      "op": "ne",
      "right": "active"
     }
    },
    {
     "reason": "certmonger does not track {bind.nickname} in the Directory Server database, so there is no renewal request to resubmit. It may not be an IPA-issued certificate.",
     "when": {
      "left": {
       "field": "found",
       "ref": "cert"
      },
      "op": "is_false"
     }
    },
    {
     "reason": "{bind.nickname} is tracked with CA '{ref.cert.ca}', not the IPA CA. Renewing it is outside what ipa-diagnose can do safely.",
     "when": {
      "left": {
       "field": "ca",
       "ref": "cert"
      },
      "op": "ne",
      "right": "IPA"
     }
    },
    {
     "reason": "The certificate has already expired (certmonger shows {ref.cert.not_after}). ipa-diagnose has no verified fix for an expired certificate.",
     "when": {
      "left": {
       "field": "days_left",
       "ref": "cert"
      },
      "op": "lt",
      "right": 0
     }
    },
    {
     "reason": "The renewal request is in state {ref.cert.state} ({ref.cert.ca_error}). That is a different problem from an upcoming expiry; resubmitting would not address it.",
     "when": {
      "left": {
       "field": "state",
       "ref": "cert"
      },
      "op": "ne",
      "right": "MONITORING"
     }
    },
    {
     "reason": "The tracking request does not restart Directory Server after renewal, which is not the standard IPA setup; ipa-diagnose will not guess the follow-up steps.",
     "when": {
      "left": {
       "field": "post_save_restarts_dirsrv",
       "ref": "cert"
      },
      "op": "is_false"
     }
    }
   ]
  },
  {
   "applies_to": {
    "freeipa_min": "4.9",
    "roles": [
     "ipa-server"
    ]
   },
   "bindings": {
    "targets_group": {
     "item": {
      "expected": "posix_name",
      "got": "posix_name",
      "path": "ipa_path"
     },
     "type": "list"
    },
    "targets_mode": {
     "item": {
      "expected": "file_mode",
      "got": "file_mode",
      "path": "ipa_path"
     },
     "type": "list"
    },
    "targets_owner": {
     "item": {
      "expected": "posix_name",
      "got": "posix_name",
      "path": "ipa_path"
     },
     "type": "list"
    }
   },
   "id": "proc.files.restore-expected-permissions",
   "investigate": [
    {
     "check": "host.privilege",
     "id": "root",
     "label": "Privileges",
     "params": {}
    },
    {
     "check": "file.stat",
     "for_each": "targets_mode",
     "id": "stat",
     "label": "Current mode of {item.path}",
     "params": {
      "path": {
       "item": "path"
      }
     }
    },
    {
     "check": "file.stat",
     "for_each": "targets_owner",
     "id": "stat",
     "label": "Current owner of {item.path}",
     "params": {
      "path": {
       "item": "path"
      }
     }
    },
    {
     "check": "file.stat",
     "for_each": "targets_group",
     "id": "stat",
     "label": "Current group of {item.path}",
     "params": {
      "path": {
       "item": "path"
      }
     }
    },
    {
     "check": "account.user",
     "for_each": "targets_owner",
     "id": "account",
     "label": "User {item.expected} exists",
     "params": {
      "name": {
       "item": "expected"
      }
     }
    },
    {
     "check": "account.group",
     "for_each": "targets_group",
     "id": "account",
     "label": "Group {item.expected} exists",
     "params": {
      "name": {
       "item": "expected"
      }
     }
    }
   ],
   "kind": "procedure",
   "limitations": "This sets only the owner, group or mode ipa-healthcheck reports; it does not change SELinux labels. If a service still cannot read the file afterwards, check 'ls -Z' and 'ausearch -m avc'. When ipa-healthcheck accepts more than one value, no fix is chosen for you.",
   "min_confidence": "MEDIUM",
   "prerequisites": [
    {
     "id": "root",
     "text": "ipa-diagnose is running as root (changing these files needs root)",
     "when": {
      "left": {
       "field": "is_root",
       "ref": "root"
      },
      "op": "is_true"
     }
    }
   ],
   "provenance": {
    "reviews": [],
    "sources": [
     {
      "kind": "upstream-code",
      "ref": "https://github.com/freeipa/freeipa-healthcheck/blob/master/src/ipahealthcheck/core/files.py",
      "title": "ipa-healthcheck FileCheck: the expected owner, group and mode are defined by ipa-healthcheck itself"
     },
     {
      "kind": "upstream-code",
      "ref": "https://github.com/freeipa/freeipa-healthcheck/blob/master/src/ipahealthcheck/ipa/files.py",
      "title": "IPAFileCheck / TomcatFileCheck file lists"
     }
    ],
    "tests": [
     "tests/resolution/test_procedures.py"
    ],
    "tier": "FIXTURE_ONLY",
    "verified_on": []
   },
   "resolves": {
    "diagnosis": "directory-server.ipa-file-permissions"
   },
   "rollback": [
    {
     "command": [
      "chmod",
      {
       "item": "got",
       "type": "file_mode"
      },
      {
       "item": "path",
       "type": "ipa_path"
      }
     ],
     "for_each": "targets_mode",
     "text": "Put the previous mode of {item.path} back"
    },
    {
     "command": [
      "chown",
      {
       "item": "got",
       "type": "posix_name"
      },
      {
       "item": "path",
       "type": "ipa_path"
      }
     ],
     "for_each": "targets_owner",
     "text": "Put the previous owner of {item.path} back"
    },
    {
     "command": [
      "chgrp",
      {
       "item": "got",
       "type": "posix_name"
      },
      {
       "item": "path",
       "type": "ipa_path"
      }
     ],
     "for_each": "targets_group",
     "text": "Put the previous group of {item.path} back"
    }
   ],
   "steps": [
    {
     "changes": [
      "file-permission"
     ],
     "command": [
      "chmod",
      {
       "item": "expected",
       "type": "file_mode"
      },
      {
       "item": "path",
       "type": "ipa_path"
      }
     ],
     "expected": "no output; the file's mode is {item.expected}",
     "for_each": "targets_mode",
     "id": "chmod",
     "risk": "LOW",
     "run_on": "local",
     "text": "Set the mode of {item.path} to {item.expected}"
    },
    {
     "changes": [
      "file-permission"
     ],
     "command": [
      "chown",
      {
       "item": "expected",
       "type": "posix_name"
      },
      {
       "item": "path",
       "type": "ipa_path"
      }
     ],
     "expected": "no output; the file is owned by {item.expected}",
     "for_each": "targets_owner",
     "id": "chown",
     "risk": "LOW",
     "run_on": "local",
     "text": "Set the owner of {item.path} to {item.expected}"
    },
    {
     "changes": [
      "file-permission"
     ],
     "command": [
      "chgrp",
      {
       "item": "expected",
       "type": "posix_name"
      },
      {
       "item": "path",
       "type": "ipa_path"
      }
     ],
     "expected": "no output; the file's group is {item.expected}",
     "for_each": "targets_group",
     "id": "chgrp",
     "risk": "LOW",
     "run_on": "local",
     "text": "Set the group of {item.path} to {item.expected}"
    }
   ],
   "title": "Set the owner, group or mode that ipa-healthcheck expects",
   "verify": [
    {
     "check": "file.stat",
     "for_each": "targets_mode",
     "params": {
      "path": {
       "item": "path"
      }
     },
     "text": "{item.path} has mode {item.expected}",
     "when": {
      "left": {
       "field": "mode",
       "ref": "this"
      },
      "op": "eq",
      "right": {
       "item": "expected"
      }
     }
    },
    {
     "check": "file.stat",
     "for_each": "targets_owner",
     "params": {
      "path": {
       "item": "path"
      }
     },
     "text": "{item.path} is owned by {item.expected}",
     "when": {
      "left": {
       "field": "owner",
       "ref": "this"
      },
      "op": "eq",
      "right": {
       "item": "expected"
      }
     }
    },
    {
     "check": "file.stat",
     "for_each": "targets_group",
     "params": {
      "path": {
       "item": "path"
      }
     },
     "text": "{item.path} has group {item.expected}",
     "when": {
      "left": {
       "field": "group",
       "ref": "this"
      },
      "op": "eq",
      "right": {
       "item": "expected"
      }
     }
    }
   ],
   "what_changes": [
    {
     "for_each": "targets_mode",
     "text": "{item.path}: mode {item.got} -> {item.expected}. Nothing else about the file changes."
    },
    {
     "for_each": "targets_owner",
     "text": "{item.path}: owner {item.got} -> {item.expected}. Nothing else about the file changes."
    },
    {
     "for_each": "targets_group",
     "text": "{item.path}: group {item.got} -> {item.expected}. Nothing else about the file changes."
    }
   ],
   "withhold_if": [
    {
     "for_each": "targets_mode",
     "reason": "{item.path} no longer exists.",
     "when": {
      "left": {
       "field": "exists",
       "ref": "stat"
      },
      "op": "is_false"
     }
    },
    {
     "for_each": "targets_owner",
     "reason": "{item.path} no longer exists.",
     "when": {
      "left": {
       "field": "exists",
       "ref": "stat"
      },
      "op": "is_false"
     }
    },
    {
     "for_each": "targets_group",
     "reason": "{item.path} no longer exists.",
     "when": {
      "left": {
       "field": "exists",
       "ref": "stat"
      },
      "op": "is_false"
     }
    },
    {
