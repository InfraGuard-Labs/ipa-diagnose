      "op": "is_true"
     }
    },
    {
     "id": "accept-jump",
     "kind": "confirm_by_admin",
     "text": "You accept that the clock on this server jumps once by about {ref.tracking.offset_seconds} s. Log entries and tickets around that moment may show odd times."
