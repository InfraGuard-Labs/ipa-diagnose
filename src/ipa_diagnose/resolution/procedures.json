   ],
   "provenance": {
    "reviews": [],
    "sources": [
     {
      "kind": "upstream-docs",
      "ref": "https://chrony-project.org/doc/4.5/chronyc.html",
      "title": "chronyc makestep: step the system clock immediately, correcting any offset"
     },
     {
      "kind": "upstream-docs",
      "ref": "https://web.mit.edu/kerberos/krb5-latest/doc/admin/conf_files/krb5_conf.html",
      "title": "MIT Kerberos clockskew (default 300 seconds)"
     }
