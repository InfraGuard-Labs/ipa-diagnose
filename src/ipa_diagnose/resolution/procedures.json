     "risk": "MEDIUM",
     "run_on": "local",
     "text": "Step the clock to the time chronyd has measured as correct"
    }
   ],
   "title": "Bring this host's clock back in sync with its time source",
   "verify": [
    {
     "check": "chrony.tracking",
     "params": {},
