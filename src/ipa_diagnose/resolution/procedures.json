    },
    {
     "for_each": "targets_owner",
     "reason": "{item.path} is a symbolic link; ipa-diagnose will not change ownership through a link.",
     "when": {
      "left": {
       "field": "is_symlink",
       "ref": "stat"
      },
      "op": "is_true"
     }
    },
    {
     "for_each": "targets_group",
     "reason": "{item.path} is a symbolic link; ipa-diagnose will not change ownership through a link.",
     "when": {
      "left": {
       "field": "is_symlink",
       "ref": "stat"
      },
      "op": "is_true"
     }
    },
    {
     "for_each": "targets_mode",
     "reason": "{item.path} already has mode {item.expected} now (checked just now).",
     "when": {
      "left": {
       "field": "mode",
