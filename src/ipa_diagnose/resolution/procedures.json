      },
      "op": "eq",
      "right": {
       "item": "expected"
      }
     }
    },
    {
     "for_each": "targets_owner",
     "reason": "{item.path} is already owned by {item.expected} now (checked just now).",
     "when": {
      "left": {
       "field": "owner",
       "ref": "stat"
      },
      "op": "eq",
      "right": {
       "item": "expected"
      }
     }
    },
    {
     "for_each": "targets_group",
     "reason": "{item.path} already has group {item.expected} now (checked just now).",
     "when": {
      "left": {
       "field": "group",
       "ref": "stat"
      },
      "op": "eq",
      "right": {
       "item": "expected"
      }
     }
    },
    {
     "for_each": "targets_mode",
